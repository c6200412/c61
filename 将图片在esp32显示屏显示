第 3 步：写显示代码（⏳ 待做）
在 src/ 里新建 photo_test.cpp，内容：
Copy code to clipboard
#include <Arduino.h>
#include <LittleFS.h>
#include <TFT_eSPI.h>

TFT_eSPI tft = TFT_eSPI();

void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setRotation(0);
  tft.fillScreen(TFT_BLACK);

  if (!LittleFS.begin()) {
    tft.drawString("LittleFS failed", 0, 0, 2);
    return;
  }
  File f = LittleFS.open("/photo.raw", "r");
  if (!f) {
    tft.drawString("no photo.raw", 0, 0, 2);
    return;
  }

  const int W = 240, H = 320;
  uint16_t row[W];
  for (int y = 0; y < H; y++) {
    f.read((uint8_t*)row, W * 2);
    tft.pushImage(0, y, W, 1, row);
  }
  f.close();
  Serial.println("done");
}

void loop() {}
重要：测试期间把你原来的 src/main.cpp 改名成 main.cpp.bak（不然两套 setup/loop 会编译冲突）。测试完再恢复。
